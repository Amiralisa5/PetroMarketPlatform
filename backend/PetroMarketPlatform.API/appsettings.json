{
  "Urls": "http://localhost:5080",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=petki.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Jwt": {
    "Issuer": "Petki.ir",
    "Audience": "Petki.ir",
    "Secret": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Otp": {
    "Length": 5,
    "TtlSeconds": 120,
    "MaxRequestsPerHour": 5,
    "MaxVerifyAttempts": 5,
    "DevExposeCode": false
  },
  "Sms": {
    "Provider": "Console",
    "SenderId": "PetkiDev"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "kyc-storage"
  },
  "Rating": {
    "Weights": {
      "Survey": 0.45,
      "SuccessfulTransactions": 0.20,
      "OnTime": 0.15,
      "InfoAccuracy": 0.10,
      "Complaints": 0.10
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
